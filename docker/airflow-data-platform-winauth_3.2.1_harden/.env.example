# =============================================================================
# Airflow Docker Compose Environment Configuration
# =============================================================================
# Copy this file to .env and update with your actual values
# DO NOT commit the actual .env file to version control
# =============================================================================

# Airflow Version
AIRFLOW_IMAGE_NAME=airflow-data-platform-winauth:3.2.1
# Set this to the host user's UID for correct file ownership.
# Example (Linux): export AIRFLOW_UID=$(id -u)
AIRFLOW_UID=<your_host_uid>

# Project Directory
AIRFLOW_PROJ_DIR=.

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=ChangeMe_SecurePassword123!
POSTGRES_DB=airflow
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=ChangeMe_RedisPassword123!
REDIS_DB=0

# =============================================================================
# AIRFLOW CORE SETTINGS
# =============================================================================
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=ChangeMe_GenerateFernetKey
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager
AIRFLOW__CORE__DEFAULT_TIMEZONE=Asia/Tehran

# =============================================================================
# AIRFLOW SECURITY & AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -base64 32
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=false
AIRFLOW__WEBSERVER__RBAC=true
AIRFLOW__WEBSERVER__SECRET_KEY=ChangeMe_GenerateWebserverSecret
AIRFLOW__WEBSERVER__BASE_URL=http://localhost:9280
AIRFLOW__WEBSERVER__SECURE_COOKIES=true
AIRFLOW__WEBSERVER__COOKIE_SAMESITE=Lax
AIRFLOW__WEBSERVER__SESSION_TIMEOUT=3600

# Airflow web login user
AIRFLOW_WWW_USER_USERNAME=airflow
AIRFLOW_WWW_USER_PASSWORD=ChangeMe_AirflowWebPassword123!

# =============================================================================
# AIRFLOW API SETTINGS (FastAPI - Airflow 3.0.6+)
# =============================================================================
# Enable REST API and Execution API
AIRFLOW__API__EXECUTION_API=true
AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-apiserver:8080/execution/
AIRFLOW__SCHEDULER__ENABLE_HEALTH_CHECK=true

# FastAPI / API Authentication
# Generate with: openssl rand -base64 32
AIRFLOW__API_AUTH__JWT_SECRET=ChangeMe_GenerateJWTSecret
AIRFLOW__API_FASTAPI__JWT_SECRET=${AIRFLOW__API_AUTH__JWT_SECRET}
AIRFLOW__API_FASTAPI__ENDPOINT_URL=http://airflow-apiserver:8080

# API CORS Configuration
AIRFLOW__API_FASTAPI__CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
AIRFLOW__API_FASTAPI__CORS_ALLOW_CREDENTIALS=true
AIRFLOW__API_FASTAPI__CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
AIRFLOW__API_FASTAPI__CORS_ALLOW_HEADERS=Content-Type,Authorization

# API Rate Limiting (requests per minute)
AIRFLOW__API__MAX_REQUESTS_PER_MINUTE=60

# API Pagination
AIRFLOW__API__MAXIMUM_PAGE_LIMIT=100

# =============================================================================
# DATABASE CONNECTION STRING
# =============================================================================
# Built from components above
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
AIRFLOW__CELERY__BROKER_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
AIRFLOW__LOGGING__LOGGING_LEVEL=INFO
TZ=Asia/Tehran
AIRFLOW__CORE__DEFAULT_TIMEZONE=Asia/Tehran
AIRFLOW__WEBSERVER__DEFAULT_UI_TIMEZONE=Asia/Tehran

# =============================================================================
# KERBEROS / WINDOWS AUTHENTICATION
# =============================================================================
KRB5_CONFIG=/etc/krb5.conf
KRB5_TRACE=/var/log/krb5_trace.log

# =============================================================================
# API CLIENT CREDENTIALS (for external services)
# =============================================================================
# Use these to authenticate to your Airflow API from external services
# Create API user in Airflow UI: Admin → Users → Create User
AIRFLOW_API_USER=api_user
AIRFLOW_API_PASSWORD=ChangeMe_StrongPassword123!

# Alternative: Use API Token (generated in Airflow UI)
AIRFLOW_API_TOKEN=""

# API Server endpoints that external services can call
AIRFLOW_API_ENDPOINT=http://localhost:9280/api/v1
AIRFLOW_EXECUTION_API_ENDPOINT=http://localhost:9280/api/v2/execution
